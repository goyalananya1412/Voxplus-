        "%%writefile scripts/evaluate.py\n",
        "\"\"\"Stress-test the detector on the dataset: detection rate, IoU and boundary error per severity.\n",
        "\n",
        "Usage: python scripts/evaluate.py --dataset dataset\n",
        "\"\"\"\n",
        "import argparse\n",
        "import pathlib\n",
        "import sys\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))\n",
        "from speechflaw.pipeline import analyze  # noqa: E402\n",
        "\n",
        "EXPECT = {\"gain\": \"LOW_VOLUME\", \"fast\": \"TOO_FAST\", \"slow\": \"TOO_SLOW\",\n",
        "          \"pause\": \"LONG_PAUSE\", \"monotone\": \"MONOTONE\"}\n",
        "\n",
        "\n",
        "def iou(a, b):\n",
        "    inter = max(0.0, min(a[1], b[1]) - max(a[0], b[0]))\n",
        "    union = (a[1] - a[0]) + (b[1] - b[0]) - inter\n",
        "    return inter / union if union > 0 else 0.0\n",
        "\n",
        "\n",
        "def main():\n",
        "    p = argparse.ArgumentParser()\n",
        "    p.add_argument(\"--dataset\", default=\"dataset\")\n",
        "    a = p.parse_args()\n",
        "    root = pathlib.Path(a.dataset)\n",
        "    df = pd.read_csv(root / \"labels.csv\")\n",
        "    rows = []\n",
        "    for name, grp in df.groupby(\"name\"):\n",
        "        good = root / grp[grp.role == \"good\"].iloc[0][\"file\"]\n",
        "        for _, r in grp[grp.role == \"bad\"].iterrows():\n",
        "            tx = (root / r[\"transcript\"]).read_text(encoding=\"utf-8\")\n",
        "            res = analyze(good, root / r[\"file\"], tx)\n",
        "            truth = (r[\"start_sec\"], r[\"end_sec\"])\n",
        "            hits = [g for g in res[\"regions\"] if g[\"type\"] == EXPECT[r[\"flaw_type\"]]]\n",
        "            best = max(hits, key=lambda g: iou(truth, (g[\"start\"], g[\"end\"])), default=None)\n",
        "            rows.append({\n",
        "                \"name\": name, \"flaw\": r[\"flaw_type\"], \"level\": r[\"level\"],\n",
        "                \"detected\": best is not None,\n",
        "                \"iou\": iou(truth, (best[\"start\"], best[\"end\"])) if best else 0.0,\n",
        "                \"start_err\": abs(best[\"start\"] - truth[0]) if best else None,\n",
        "                \"end_err\": abs(best[\"end\"] - truth[1]) if best else None,\n",
        "                \"other_flags\": len(res[\"regions\"]) - len(hits),\n",
        "                \"overall_score\": res[\"scores\"][\"overall\"],\n",
        "            })\n",
        "            print(rows[-1])\n",
        "    out = pd.DataFrame(rows)\n",
        "    out.to_csv(root / \"evaluation.csv\", index=False)\n",
        "    print(\"\\n=== by severity level (1 egregious ... 5 near-perfect) ===\")\n",
        "    print(out.groupby(\"level\")[[\"detected\", \"iou\", \"start_err\", \"end_err\", \"other_flags\", \"overall_score\"]]\n",
        "          .mean().round(2))\n",
        "    print(\"\\n=== by flaw type ===\")\n",
        "    print(out.groupby(\"flaw\")[[\"detected\", \"iou\", \"overall_score\"]].mean().round(2))\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
