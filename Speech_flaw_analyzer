        "%%writefile scripts/make_dataset.py\n",
        "\"\"\"Build a contrastive 'bad-mirror' gradient from one good recording of a public speech.\n",
        "\n",
        "Every flaw is injected into a known REGION, so start/end labels are exact ground truth.\n",
        "Severity levels: 1 = egregious ... 5 = near-perfect.\n",
        "\n",
        "Usage:\n",
        "  python scripts/make_dataset.py --good speech.mp3 --transcript speech.txt --name obama_sample --out dataset\n",
        "\"\"\"\n",
        "import argparse\n",
        "import csv\n",
        "import pathlib\n",
        "import shutil\n",
        "\n",
        "import librosa\n",
        "import numpy as np\n",
        "import soundfile as sf\n",
        "\n",
        "SR = 16000\n",
        "LEVELS = {\n",
        "    \"gain\":     [-24, -16, -10, -6, -3],               # dB change inside region\n",
        "    \"fast\":     [2.0, 1.7, 1.45, 1.25, 1.1],           # time-stretch rate (pitch preserved)\n",
        "    \"slow\":     [0.5, 0.6, 0.7, 0.8, 0.92],\n",
        "    \"pause\":    [4.0, 2.5, 1.5, 1.0, 0.8],             # seconds of inserted silence\n",
        "    \"monotone\": [1.0, 0.85, 0.7, 0.5, 0.3],            # fraction of pitch deviation removed\n",
        "}\n",
        "DESC = {1: \"egregious\", 2: \"severe\", 3: \"moderate\", 4: \"mild\", 5: \"near-perfect\"}\n",
        "\n",
        "\n",
        "def snap(y, t, search=0.3):\n",
        "    \"\"\"Move t to the quietest nearby frame so we never cut through a word.\"\"\"\n",
        "    hop = 160\n",
        "    rms = librosa.feature.rms(y=y, frame_length=400, hop_length=hop)[0]\n",
        "    c, r = int(t * SR / hop), int(search * SR / hop)\n",
        "    lo, hi = max(c - r, 0), min(c + r, len(rms))\n",
        "    return (lo + int(np.argmin(rms[lo:hi]))) * hop / SR\n",
        "\n",
        "\n",
        "def apply_gain(y, a, b, db):\n",
        "    env = np.ones(len(y))\n",
        "    env[a:b] = 10 ** (db / 20)\n",
        "    k = int(0.02 * SR)                                  # 20 ms smoothing, no clicks\n",
        "    env = np.convolve(np.pad(env, (k, k), mode=\"edge\"), np.ones(k) / k, mode=\"same\")[k:-k]\n",
        "    return y * env, a / SR, b / SR\n",
        "\n",
        "\n",
        "def apply_stretch(y, a, b, rate):\n",
        "    seg = librosa.effects.time_stretch(y[a:b], rate=rate)\n",
        "    return np.concatenate([y[:a], seg, y[b:]]), a / SR, a / SR + len(seg) / SR\n",
        "\n",
        "\n",
        "def apply_pause(y, a, b, dur):\n",
        "    return np.concatenate([y[:a], np.zeros(int(dur * SR)), y[a:]]), a / SR, a / SR + dur\n",
        "\n",
        "\n",
        "def apply_monotone(y, a, b, alpha):\n",
        "    import pyworld as pw                                # pip install pyworld\n",
        "    x = y[a:b].astype(np.float64)\n",
        "    f0, t = pw.harvest(x, SR)\n",
        "    sp, ap = pw.cheaptrick(x, f0, t, SR), pw.d4c(x, f0, t, SR)\n",
        "    v = f0 > 0\n",
        "    med = np.median(f0[v])\n",
        "    f0n = f0.copy()\n",
        "    f0n[v] = med * (f0[v] / med) ** (1 - alpha)\n",
        "    seg = pw.synthesize(f0n, sp, ap, SR)\n",
        "    seg = librosa.util.fix_length(seg, size=b - a)\n",
        "    return np.concatenate([y[:a], seg.astype(y.dtype), y[b:]]), a / SR, b / SR\n",
        "\n",
        "\n",
        "APPLY = {\"gain\": apply_gain, \"fast\": apply_stretch, \"slow\": apply_stretch,\n",
        "         \"pause\": apply_pause, \"monotone\": apply_monotone}\n",
        "\n",
        "\n",
        "def main():\n",
        "    p = argparse.ArgumentParser()\n",
        "    p.add_argument(\"--good\", required=True)\n",
        "    p.add_argument(\"--transcript\", required=True)\n",
        "    p.add_argument(\"--name\", required=True)\n",
        "    p.add_argument(\"--out\", default=\"dataset\")\n",
        "    p.add_argument(\"--region\", help=\"start,end seconds of the region to damage (default: auto)\")\n",
        "    p.add_argument(\"--region-len\", type=float, default=3.0)\n",
        "    a = p.parse_args()\n",
        "\n",
        "    out = pathlib.Path(a.out)\n",
        "    (out / \"audio\").mkdir(parents=True, exist_ok=True)\n",
        "    (out / \"transcripts\").mkdir(exist_ok=True)\n",
        "\n",
        "    y, _ = librosa.load(a.good, sr=SR, mono=True)\n",
        "    y = (y / np.max(np.abs(y)) * 0.7).astype(np.float32)   # fixed peak level = fixed gain basis\n",
        "    dur = len(y) / SR\n",
        "    if a.region:\n",
        "        t0, t1 = map(float, a.region.split(\",\"))\n",
        "    else:\n",
        "        t0 = snap(y, 0.3 * dur)\n",
        "        t1 = snap(y, t0 + min(a.region_len, 0.35 * dur))\n",
        "    ia, ib = int(t0 * SR), int(t1 * SR)\n",
        "\n",
        "    tx = out / \"transcripts\" / f\"{a.name}.txt\"\n",
        "    shutil.copy(a.transcript, tx)\n",
        "    good_name = f\"{a.name}_good.wav\"\n",
        "    sf.write(out / \"audio\" / good_name, y, SR)\n",
        "\n",
        "    labels = out / \"labels.csv\"\n",
        "    new = not labels.exists()\n",
        "    fields = [\"name\", \"role\", \"file\", \"flaw_type\", \"level\", \"level_desc\", \"param\",\n",
        "              \"start_sec\", \"end_sec\", \"transcript\"]\n",
        "    with open(labels, \"a\", newline=\"\") as f:\n",
        "        w = csv.DictWriter(f, fields)\n",
        "        if new:\n",
        "            w.writeheader()\n",
        "        w.writerow({\"name\": a.name, \"role\": \"good\", \"file\": f\"audio/{good_name}\", \"flaw_type\": \"none\",\n",
        "                    \"level\": 0, \"level_desc\": \"baseline\", \"param\": \"\", \"start_sec\": \"\", \"end_sec\": \"\",\n",
        "                    \"transcript\": f\"transcripts/{a.name}.txt\"})\n",
        "        for flaw, params in LEVELS.items():\n",
        "            for lvl, prm in enumerate(params, start=1):\n",
        "                try:\n",
        "                    yb, s, e = APPLY[flaw](y, ia, ib, prm)\n",
        "                except ImportError:\n",
        "                    print(f\"skip {flaw}: pip install pyworld\")\n",
        "                    break\n",
        "                fn = f\"{a.name}_{flaw}_L{lvl}.wav\"\n",
        "                sf.write(out / \"audio\" / fn, np.clip(yb, -1, 1).astype(np.float32), SR)\n",
        "                w.writerow({\"name\": a.name, \"role\": \"bad\", \"file\": f\"audio/{fn}\", \"flaw_type\": flaw,\n",
        "                            \"level\": lvl, \"level_desc\": DESC[lvl], \"param\": prm,\n",
        "                            \"start_sec\": round(s, 3), \"end_sec\": round(e, 3),\n",
        "                            \"transcript\": f\"transcripts/{a.name}.txt\"})\n",
        "    print(f\"Done. Region {t0:.2f}-{t1:.2f}s. Files in {out}/audio, labels in {labels}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
    },
