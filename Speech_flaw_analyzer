        "                         showlegend=False, connectgaps=False), 2, 1)\n",
        "fig.add_trace(go.Scatter(x=t, y=cv[\"pitch_flaw\"], name=\"Participant pitch\", line=dict(color=\"#e74c3c\"),\n",
        "                         showlegend=False, connectgaps=False), 2, 1)\n",
        "wt = [w[\"t\"] for w in cv[\"windows\"]]\n",
        "for key, color in ((\"energy\", \"#e74c3c\"), (\"pitch\", \"#16a085\"), (\"rate\", \"#e67e22\")):\n",
        "    fig.add_trace(go.Scatter(x=wt, y=[w[key] for w in cv[\"windows\"]], name=f\"z {key}\",\n",
        "                             line=dict(color=color)), 3, 1)\n",
        "for y0 in (2, -2):\n",
        "    fig.add_hline(y=y0, line_dash=\"dot\", line_color=\"gray\", row=3, col=1)\n",
        "for r in res[\"regions\"]:\n",
        "    for row in (1, 2, 3):\n",
        "        fig.add_vrect(x0=r[\"start\"], x1=r[\"end\"], row=row, col=1, fillcolor=COLORS.get(r[\"type\"], \"gray\"),\n",
        "                      opacity=0.18, line_width=0, layer=\"below\")\n",
        "fig.update_xaxes(title_text=\"Participant time (s)\", row=3, col=1)\n",
        "fig.update_layout(height=760, margin=dict(t=60, b=20), legend=dict(orientation=\"h\", y=1.08))\n",
        "st.plotly_chart(fig, use_container_width=True)\n",
