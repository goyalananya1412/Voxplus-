        "if go_btn:\n",
        "    tx = tx_file.getvalue().decode(\"utf-8\") if tx_file else None\n",
        "    st.session_state[\"res\"] = run(base.getvalue(), base.name, flaw.getvalue(), flaw.name, tx)\n",
