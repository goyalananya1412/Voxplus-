        "%%writefile app.py\n",
        "\"\"\"Interactive dashboard:  streamlit run app.py\"\"\"\n",
        "import json\n",
        "import os\n",
        "import tempfile\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "import streamlit as st\n",
