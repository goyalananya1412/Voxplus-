        "FRAME = 400                # 25 ms analysis frame\n",
        "N_FFT = 512\n",
        "N_MELS = 40\n",
        "N_MFCC = 13\n",
        "HOP_SEC = HOP / SR\n",
        "\n",
        "# --- pitch (pYIN) ---------------------------------------------------------\n",
        "F0_MIN = 65.0              # Hz (C2)\n",
        "F0_MAX = 400.0             # Hz (about G4) - 300 Hz was clipping real voices\n",
        "\n",
        "# --- speech activity / pauses --------------------------------------------\n",
        "ACTIVE_DB = 30.0           # frames within 30 dB of the 98th-percentile level = speech\n",
        "MIN_PAUSE_SEC = 0.15       # shorter silences are articulation gaps, not pauses\n",
        "\n",
        "# --- syllable nuclei (speech-rate proxy) ---------------------------------\n",
        "PEAK_PROM_DB = 4.0\n",
        "PEAK_DIST = 8              # frames (80 ms)\n",
        "\n",
        "# --- sliding-window comparison -------------------------------------------\n",
        "WIN_SEC = 1.0\n",
        "WIN_HOP_SEC = 0.25\n",
        "MIN_ACTIVE_SEC = 0.3       # window needs this much speech to be judged\n",
        "MIN_VOICED_FRAMES = 15\n",
        "MIN_REGION_WINDOWS = 2     # a flaw must persist for >= 2 windows\n",
        "Z_FLAG = 2.0               # flag when deviation > 2 sigma\n",
        "\n",
        "# sigma (\"tolerance band\") per feature; deviation z = delta / sigma\n",
        "TOL_ENERGY_DB = 2.0        # about the just-noticeable loudness difference\n",
