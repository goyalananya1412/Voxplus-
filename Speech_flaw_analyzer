        "import sys, numpy as np, pandas as pd, librosa, soundfile as sf\n",
        "from scripts import make_dataset as md\n",
        "SR = 16000\n",
        "y, _ = librosa.load('dataset/audio/speech1_good.wav', sr=SR)\n",
        "dur = len(y) / SR\n",
        "cuts = [int(md.snap(y, t) * SR) for t in np.arange(1.5, dur - 1, 2.0)]\n",
        "pieces = np.split(y, cuts)\n",
        "rows = [['speech1_full', 'good', 'audio/speech1_good.wav', 'none', 0, 'baseline', '', '', '', 'transcripts/speech1.txt']]\n",
        "\n",
        "def make(flaw, lvl, prm):\n",
        "    if flaw == 'pause':\n",
        "       yb = np.concatenate([np.concatenate([p, np.zeros(int(prm * SR))]) for p in pieces[:-1]] + [pieces[-1]])\n",
        "    else:\n",
        "       yb = md.APPLY[flaw](y, 0, len(y), prm)[0]\n",
        "    fn = f'speech1_full_{flaw}_L{lvl}.wav'\n",
        "    sf.write('dataset/audio/' + fn, np.clip(yb, -1, 1).astype(np.float32), SR)\n",
        "    rows.append(['speech1_full', 'bad', 'audio/' + fn, flaw, lvl, md.DESC[lvl], prm, 0, round(len(yb) / SR, 3), 'transcripts/speech1.txt'])\n",
        "\n",
        "levels = dict(md.LEVELS, pause=[2.0, 1.4, 1.0, 0.7, 0.4])\n",
        "[make(f, 2, ps[1]) for f, ps in levels.items()]\n",
        "pd.DataFrame(rows).to_csv('dataset/labels.csv', mode='a', header=False, index=False)\n",
        "print(len(rows) - 1, 'fully flawed files created')"
      ]
