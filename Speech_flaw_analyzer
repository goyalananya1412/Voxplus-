        "%%writefile speechflaw/features.py\n",
        "\"\"\"Acoustic feature extraction: STFT/FFT, MFCC, RMS, pYIN F0, pauses, syllable nuclei.\"\"\"\n",
        "import numpy as np\n",
        "import librosa\n",
        "from scipy.ndimage import uniform_filter1d\n",
        "from scipy.signal import find_peaks\n",
        "\n",
        "from . import config as C\n",
        "from .metrics import runs\n",
        "\n",
        "\n",
        "def load_audio(path):\n",
        "    \"\"\"Load any audio file as 16 kHz mono float32.\"\"\"\n",
        "    y, _ = librosa.load(path, sr=C.SR, mono=True)\n",
        "    return y\n",
        "\n",
        "\n",
        "def extract(y):\n",
        "    \"\"\"Return a dict of frame-level (10 ms) features plus pauses and syllable peaks.\"\"\"\n",
        "    # FFT -> power spectrogram -> mel -> MFCC\n",
        "    S = np.abs(librosa.stft(y, n_fft=C.N_FFT, hop_length=C.HOP, win_length=C.FRAME))\n",
        "    mel = librosa.feature.melspectrogram(S=S ** 2, sr=C.SR, n_mels=C.N_MELS)\n",
        "    mfcc = librosa.feature.mfcc(S=librosa.power_to_db(mel), n_mfcc=C.N_MFCC)\n",
        "    centroid = librosa.feature.spectral_centroid(S=S, sr=C.SR)[0]\n",
        "    flatness = librosa.feature.spectral_flatness(S=S)[0]      # noisiness / clarity proxy\n",
        "\n",
        "    # loudness (time domain RMS, in dB)\n",
        "    rms = librosa.feature.rms(y=y, frame_length=C.FRAME, hop_length=C.HOP)[0]\n",
        "    rms_db = 20 * np.log10(rms + 1e-6)\n",
        "\n",
        "    # pitch (pYIN gives a proper voiced/unvoiced decision, unlike plain YIN)\n",
        "    f0, vflag, _ = librosa.pyin(y, fmin=C.F0_MIN, fmax=C.F0_MAX, sr=C.SR,\n",
        "                                frame_length=1024, hop_length=C.HOP)\n",
        "\n",
        "    n = min(len(rms_db), len(f0), mfcc.shape[1], len(centroid), len(flatness))\n",
        "    rms_db, f0, vflag = rms_db[:n], f0[:n], vflag[:n]\n",
        "    mfcc, centroid, flatness = mfcc[:, :n], centroid[:n], flatness[:n]\n",
        "\n",
        "    # speech activity + pauses\n",
        "    thr = np.percentile(rms_db, 98) - C.ACTIVE_DB\n",
        "    active = rms_db > thr\n",
        "    min_p = int(round(C.MIN_PAUSE_SEC / C.HOP_SEC))\n",
        "    pauses = []\n",
        "    for s, e in runs(~active):\n",
        "        if s == 0 or e == n:            # leading / trailing silence is not a pause\n",
        "            continue\n",
        "        if e - s < min_p:\n",
        "            active[s:e] = True          # bridge tiny gaps\n",
        "        else:\n",
        "            pauses.append((s * C.HOP_SEC, e * C.HOP_SEC))\n",
        "\n",
        "    # speaker-normalised pitch: semitones relative to this speaker's median F0\n",
        "    voiced = vflag.astype(bool) & active\n",
        "    f0v = np.where(voiced, f0, np.nan)\n",
        "    med = float(np.nanmedian(f0v)) if voiced.sum() >= C.MIN_VOICED_FRAMES else 120.0\n",
        "    f0_st = 12 * np.log2(f0v / med)\n",
        "\n",
        "    # syllable nuclei = prominent peaks of the smoothed energy envelope\n",
        "    env = uniform_filter1d(rms_db, size=5)\n",
        "    peaks, _ = find_peaks(env, prominence=C.PEAK_PROM_DB, distance=C.PEAK_DIST)\n",
        "    peaks = peaks[active[peaks]]\n",
        "\n",
        "    return {\n",
        "        \"n\": n, \"duration\": n * C.HOP_SEC, \"rms_db\": rms_db, \"active\": active,\n",
        "        \"f0_st\": f0_st, \"median_f0_hz\": med, \"mfcc\": mfcc, \"centroid\": centroid,\n",
        "        \"flatness\": flatness, \"peaks\": peaks, \"pauses\": pauses,\n",
        "    }\n"
      ]
