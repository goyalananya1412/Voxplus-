        "%%writefile speechflaw/pipeline.py\n",
        "\"\"\"End-to-end analysis + CLI:  python -m speechflaw.pipeline good.wav bad.wav --transcript t.txt\"\"\"\n",
        "import argparse\n",
        "import json\n",
        "\n",
        "from . import align, compare, features\n",
        "\n",
        "\n",
        "def analyze(base_path, flaw_path, transcript=None):\n",
        "    yb, yf = features.load_audio(base_path), features.load_audio(flaw_path)\n",
        "    fb, ff = features.extract(yb), features.extract(yf)\n",
        "    res = compare.run(fb, ff)\n",
        "    res[\"words\"] = []\n",
        "    if transcript and transcript.strip():\n",
        "        words = align.forced_align(yf, transcript, ff)\n",
        "        for w in words:\n",
        "            w[\"flags\"] = sorted({r[\"type\"] for r in res[\"regions\"]\n",
        "                                 if w[\"end\"] > r[\"start\"] and w[\"start\"] < r[\"end\"]})\n",
        "        res[\"words\"] = words\n",
        "        res[\"global\"][\"words_per_sec_flaw\"] = round(len(words) / ff[\"duration\"], 2)\n",
        "    return res\n",
        "\n",
        "\n",
        "def main():\n",
        "    p = argparse.ArgumentParser()\n",
        "    p.add_argument(\"baseline\")\n",
        "    p.add_argument(\"participant\")\n",
        "    p.add_argument(\"--transcript\", help=\"path to a .txt transcript\")\n",
        "    p.add_argument(\"--out\", default=\"evaluation_results.json\")\n",
        "    a = p.parse_args()\n",
        "    text = open(a.transcript, encoding=\"utf-8\").read() if a.transcript else None\n",
        "    res = analyze(a.baseline, a.participant, text)\n",
        "    with open(a.out, \"w\") as f:\n",
        "        json.dump(res, f, indent=2)\n",
        "    print(f\"Overall {res['scores']['overall']}/100  |  {len(res['regions'])} flaw region(s)\")\n",
        "    for r in res[\"regions\"]:\n",
        "        print(f\"  {r['start']:6.2f}-{r['end']:6.2f}s  {r['type']:<14} {r['explanation']}\")\n",
        "    print(f\"Saved {a.out}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
