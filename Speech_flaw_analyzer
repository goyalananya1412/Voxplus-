        "%%writefile speechflaw/align.py\n",
        "\"\"\"Forced alignment: transcript words -> audio timestamps.\n",
        "\n",
        "Primary: torchaudio MMS_FA (CTC forced aligner, needs `pip install torch torchaudio`,\n",
        "downloads weights on first run). Fallback: proportional alignment over the speech span\n",
        "(clearly marked method='proportional', less precise).\n",
        "\"\"\"\n",
        "import re\n",
        "import numpy as np\n",
        "from . import config as C\n",
        "\n",
        "\n",
        "def normalize_words(text):\n",
        "    \"\"\"Lower-case letters and apostrophes only (spell numbers out in the transcript).\"\"\"\n",
        "    return re.findall(r\"[a-z']+\", text.lower())\n",
        "\n",
        "\n",
        "def _proportional(words, feat):\n",
        "    idx = np.where(feat[\"active\"])[0]\n",
        "    t0 = idx[0] * C.HOP_SEC if len(idx) else 0.0\n",
        "    t1 = (idx[-1] + 1) * C.HOP_SEC if len(idx) else feat[\"duration\"]\n",
        "    w = np.array([len(x) for x in words], float)\n",
        "    edges = t0 + (t1 - t0) * np.concatenate([[0], np.cumsum(w) / w.sum()])\n",
        "    return [{\"word\": x, \"start\": round(float(edges[i]), 3), \"end\": round(float(edges[i + 1]), 3),\n",
        "             \"score\": None, \"method\": \"proportional\"} for i, x in enumerate(words)]\n",
        "\n",
        "\n",
        "def forced_align(y, transcript, feat):\n",
        "    words = normalize_words(transcript)\n",
        "    if not words:\n",
        "        return []\n",
        "    try:\n",
        "        import torch\n",
        "        import torchaudio\n",
        "        import torchaudio.functional as F\n",
        "        bundle = torchaudio.pipelines.MMS_FA\n",
        "        model = bundle.get_model(with_star=False).eval()\n",
        "        tokenizer, aligner = bundle.get_tokenizer(), bundle.get_aligner()\n",
        "        wav = torch.from_numpy(np.asarray(y, dtype=np.float32)).unsqueeze(0)\n",
        "        if C.SR != bundle.sample_rate:\n",
        "            wav = F.resample(wav, C.SR, bundle.sample_rate)\n",
        "        with torch.inference_mode():\n",
        "            emission, _ = model(wav)\n",
        "        spans = aligner(emission[0], tokenizer(words))\n",
        "        ratio = wav.size(1) / emission.size(1) / bundle.sample_rate\n",
        "        out = []\n",
        "        for w, sp in zip(words, spans):\n",
        "            out.append({\"word\": w, \"start\": round(sp[0].start * ratio, 3),\n",
        "                        \"end\": round(sp[-1].end * ratio, 3),\n",
        "                        \"score\": round(float(np.mean([t.score for t in sp])), 3),\n",
        "                        \"method\": \"mms_fa\"})\n",
        "        return out\n",
        "    except Exception as e:  # missing torch, no internet, odd characters...\n",
        "        print(f\"[align] forced aligner unavailable ({type(e).__name__}: {e}); using proportional fallback\")\n",
        "        return _proportional(words, feat)\n"
      ]
    },
