        "%%writefile speechflaw/metrics.py\n",
        "\"\"\"Pure-numpy helpers (no librosa) so the logic is easy to unit-test.\"\"\"\n",
        "import numpy as np\n",
        "from . import config as C\n",
        "\n",
        "\n",
        "def runs(mask):\n",
        "    \"\"\"(start, end_exclusive) index pairs of consecutive True values.\"\"\"\n",
        "    m = np.concatenate([[False], np.asarray(mask, bool), [False]]).astype(np.int8)\n",
        "    d = np.diff(m)\n",
        "    return list(zip(np.where(d == 1)[0], np.where(d == -1)[0]))\n",
        "\n",
        "\n",
        "def window_metrics(feat, a, b):\n",
        "    \"\"\"Speaker-normalised metrics over frames [a, b).\n",
        "\n",
        "    energy : mean RMS level (dB) over speech frames\n",
        "    pitch  : P90-P10 of F0 in semitones relative to the speaker's median\n",
        "    rate   : syllable nuclei per second of *speech* time (pauses excluded)\n",
        "    \"\"\"\n",
        "    nan = float(\"nan\")\n",
        "    out = {\"energy\": nan, \"pitch\": nan, \"rate\": nan, \"speech_frac\": 0.0}\n",
        "    a, b = max(int(a), 0), min(int(b), feat[\"n\"])\n",
        "    if b - a < 2:\n",
        "        return out\n",
        "    act = feat[\"active\"][a:b]\n",
        "    n_act = int(act.sum())\n",
        "    out[\"speech_frac\"] = n_act / (b - a)\n",
        "    if n_act * C.HOP_SEC < C.MIN_ACTIVE_SEC:\n",
        "        return out\n",
        "    out[\"energy\"] = float(feat[\"rms_db\"][a:b][act].mean())\n",
        "    st = feat[\"f0_st\"][a:b]\n",
        "    st = st[~np.isnan(st)]\n",
        "    if len(st) >= C.MIN_VOICED_FRAMES:\n",
        "        out[\"pitch\"] = float(np.percentile(st, 90) - np.percentile(st, 10))\n",
        "    pk = feat[\"peaks\"]\n",
        "    n_pk = int(((pk >= a) & (pk < b)).sum())\n",
        "    out[\"rate\"] = n_pk / (n_act * C.HOP_SEC)\n",
        "    return out\n"
      ]
