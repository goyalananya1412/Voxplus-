        "          \"LONG_PAUSE\": \"#8e44ad\", \"MONOTONE\": \"#16a085\", \"ERRATIC_PITCH\": \"#2980b9\"}\n",
        "\n",
        "\n",
        "@st.cache_data(show_spinner=\"Extracting features, aligning and comparing...\")\n",
        "def run(base_bytes, base_name, flaw_bytes, flaw_name, transcript):\n",
        "    paths = []\n",
        "    for data, name in ((base_bytes, base_name), (flaw_bytes, flaw_name)):\n",
        "        f = tempfile.NamedTemporaryFile(delete=False, suffix=os.path.splitext(name)[1] or \".wav\")\n",
        "        f.write(data)\n",
        "        f.close()\n",
        "        paths.append(f.name)\n",
        "    try:\n",
        "        return analyze(paths[0], paths[1], transcript)\n",
        "    finally:\n",
        "        for p in paths:\n",
        "            os.unlink(p)\n",
        "\n",
        "\n",
        "st.title(\"Contrastive Speech Analytics\")\n",
        "st.caption(\"Upload a good baseline and a participant recording of the same speech. \"\n",
        "           \"Speaker-agnostic: pitch is in semitones around each speaker's median.\")\n",
        "\n",
        "with st.sidebar:\n",
        "    base = st.file_uploader(\"Baseline (ideal) audio\", type=[\"wav\", \"mp3\", \"flac\", \"m4a\", \"ogg\"])\n",
        "    flaw = st.file_uploader(\"Participant audio\", type=[\"wav\", \"mp3\", \"flac\", \"m4a\", \"ogg\"])\n",
        "    tx_file = st.file_uploader(\"Transcript (.txt, optional)\", type=[\"txt\"])\n",
        "    go_btn = st.button(\"Analyze\", type=\"primary\", disabled=not (base and flaw))\n",
        "\n",
        "if not (base and flaw):\n",
        "    st.info(\"Upload both audio files in the sidebar to begin.\")\n",
        "    st.stop()\n",
        "\n",
        "st.audio(base.getvalue(), format=base.type or \"audio/wav\")\n",
        "st.caption(\"Baseline\")\n",
        "st.audio(flaw.getvalue(), format=flaw.type or \"audio/wav\")\n",
        "st.caption(\"Participant\")\n",
        "\n",
        "if not go_btn and \"res\" not in st.session_state:\n",
