      "source": [
        "import sys, glob, zipfile, os, shutil, textwrap\n",
        "sys.path.insert(0, '.')\n",
        "from google.colab import files\n",
        "from speechflaw.pipeline import analyze\n",
        "\n",
        "BASELINE = None   # optional: part of the baseline file name, e.g. 'good'\n",
        "EXT = ('.wav', '.mp3', '.flac', '.m4a', '.ogg')\n",
        "\n",
        "up = files.upload()\n",
        "shutil.rmtree('audio_data', ignore_errors=True)\n",
        "os.makedirs('audio_data')\n",
        "for name in up:\n",
        "    if name.lower().endswith('.zip'):\n",
        "        zipfile.ZipFile(name).extractall('audio_data')\n",
        "    elif name.lower().endswith(EXT):\n",
        "        shutil.copy(name, 'audio_data')\n",
        "\n",
        "audio = sorted(p for p in glob.glob('audio_data/**/*', recursive=True)\n",
        "               if p.lower().endswith(EXT) and '__MACOSX' not in p\n",
        "               and not os.path.basename(p).startswith('._'))\n",
        "print(f\"Found {len(audio)} audio files:\")\n",
        "for p in audio:\n",
        "    print(\"  \", p)\n",
        "\n",
        "keys = [BASELINE] if BASELINE else ['normal', 'good', 'baseline', 'ideal', 'original', 'reference']\n",
        "base = next((p for k in keys for p in audio if k.lower() in os.path.basename(p).lower()), audio[0])\n",
        "print(\"\\nBASELINE:\", base)\n",
        "\n",
        "def report(name, r):\n",
        "    s, g = r['scores'], r['global']\n",
        "    dims = {k: s[k] for k in ('volume', 'pacing', 'pauses', 'pitch')}\n",
        "    worst = min(dims, key=dims.get)\n",
        "    print('\\n' + '=' * 70)\n",
        "    print(os.path.basename(name))\n",
        "    print(f\"OVERALL {s['overall']}/100 | volume {s['volume']} | pacing {s['pacing']} | pauses {s['pauses']} | pitch {s['pitch']}\")\n",
        "    print(f\"Weakest area: {worst} ({dims[worst]}/100)\")\n",
        "    print(f\"Duration {g['duration_base']}s -> {g['duration_flaw']}s | syllables/s {g['syllable_rate_base']} -> {g['syllable_rate_flaw']} | \"\n",
        "          f\"loudness {g['mean_energy_db_base']} -> {g['mean_energy_db_flaw']} dB | pauses {g['n_pauses_base']} -> {g['n_pauses_flaw']}\")\n",
        "    if not r['regions']:\n",
        "        print(\"\\nNo region deviates from the baseline by more than 2 sigma, so delivery matches the ideal recording.\")\n",
        "    for i, reg in enumerate(r['regions'], 1):\n",
        "        print(f\"\\n[{i}] {reg['start']:.2f}s to {reg['end']:.2f}s | {reg['type']} | {reg['severity_z']} sigma\")\n",
        "        print(textwrap.fill(\"WHY: \" + reg['explanation'], 90, subsequent_indent='     '))\n",
        "\n",
        "results = {}\n",
        "for w in audio:\n",
        "    if w == base:\n",
        "        continue\n",
        "    results[w] = analyze(base, w)\n",
        "    report(w, results[w])\n"
      ]
