        "%%writefile speechflaw/compare.py\n",
        "\"\"\"Contrastive analysis: DTW alignment, windowed deviation, flaw regions, causal text, scores.\"\"\"\n",
        "import warnings\n",
        "import numpy as np\n",
        "\n",
        "from . import config as C\n",
        "from .metrics import window_metrics\n",
        "\n",
        "RULES = {  # feature -> (type when z > +Z, type when z < -Z)\n",
        "    \"energy\": (\"TOO_LOUD\", \"LOW_VOLUME\"),\n",
        "    \"pitch\": (\"ERRATIC_PITCH\", \"MONOTONE\"),\n",
        "    \"rate\": (\"TOO_FAST\", \"TOO_SLOW\"),\n",
        "}\n",
        "TOL = {\"energy\": C.TOL_ENERGY_DB, \"pitch\": C.TOL_PITCH_ST, \"rate\": C.TOL_RATE}\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------- DTW alignment\n",
        "def dtw_map(fb, ff):\n",
        "    \"\"\"For every participant frame j, the matching baseline frame range [lo[j], hi[j]).\"\"\"\n",
        "    import librosa\n",
        "    ds = C.DTW_DS\n",
        "\n",
        "    def prep(m):\n",
        "        m = m[1:]                                              # drop c0 (gain dependent)\n",
        "        m = (m - m.mean(1, keepdims=True)) / (m.std(1, keepdims=True) + 1e-8)  # per-file CMVN\n",
        "        return m[:, ::ds]\n",
        "\n",
        "    X, Y = prep(fb[\"mfcc\"]), prep(ff[\"mfcc\"])\n",
        "    _, wp = librosa.sequence.dtw(X=X, Y=Y, metric=\"cosine\")\n",
        "    nX, nY = X.shape[1], Y.shape[1]\n",
        "    lo = np.full(nY, nX, dtype=int)\n",
        "    hi = np.zeros(nY, dtype=int)\n",
        "    for i, j in wp:\n",
        "        lo[j] = min(lo[j], i)\n",
        "        hi[j] = max(hi[j], i)\n",
        "    j_idx = np.minimum(np.arange(ff[\"n\"]) // ds, nY - 1)\n",
        "    lo_f = np.minimum(lo[j_idx] * ds, fb[\"n\"] - 1)\n",
        "    hi_f = np.minimum((hi[j_idx] + 1) * ds, fb[\"n\"])\n",
        "    return lo_f, np.maximum(hi_f, lo_f + 1)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------- helpers\n",
        "def _ok(*v):\n",
        "    return all(x == x for x in v)       # not NaN\n",
        "\n",
        "\n",
        "def _merge(ws):\n",
        "    groups, cur = [], []\n",
        "    for w in ws:\n",
        "        if cur and w[\"t0\"] <= cur[-1][\"t1\"] + 1e-6:\n",
        "            cur.append(w)\n",
        "        else:\n",
        "            if cur:\n",
        "                groups.append(cur)\n",
        "            cur = [w]\n",
        "    if cur:\n",
        "        groups.append(cur)\n",
        "    return groups\n",
        "\n",
        "\n",
        "def _nanmean(x):\n",
        "    x = np.asarray(x, float)\n",
        "    x = x[~np.isnan(x)]\n",
        "    return float(x.mean()) if len(x) else float(\"nan\")\n",
        "\n",
        "\n",
        "def _clean(arr):\n",
        "    return [None if (v is None or v != v) else round(float(v), 3) for v in arr]\n",
        "\n",
        "\n",
        "def explain(r):\n",
        "    t, z, bm, fm = r[\"type\"], r[\"z\"], r[\"base\"], r[\"flaw\"]\n",
        "    if t in (\"LOW_VOLUME\", \"TOO_LOUD\"):\n",
        "        word = \"dropped\" if t == \"LOW_VOLUME\" else \"rose\"\n",
        "        tip = (\"The passage will be hard to hear; project from the diaphragm and keep energy up to the end of phrases.\"\n",
        "               if t == \"LOW_VOLUME\" else \"Loudness overshoots the baseline; ease off so emphasis still stands out.\")\n",
        "        return (f\"Loudness {word} to {fm:.1f} dB vs {bm:.1f} dB on the same words (delta {fm - bm:+.1f} dB = {z:.1f} sigma, \"\n",
        "                f\"sigma={C.TOL_ENERGY_DB} dB). Level is 20*log10(RMS), so amplitude is about \"\n",
        "                f\"{10 ** ((fm - bm) / 20) * 100:.0f}% of the baseline. {tip}\")\n",
        "    if t in (\"MONOTONE\", \"ERRATIC_PITCH\"):\n",
        "        tip = (\"A flat F0 contour removes emphasis cues; lift pitch on key words and fall at sentence ends.\"\n",
        "               if t == \"MONOTONE\" else \"Pitch swings far more than the baseline; steady the melody so it sounds controlled.\")\n",
        "        return (f\"Pitch range (P90-P10 of F0, in semitones around the speaker's own median) is {fm:.1f} st vs {bm:.1f} st \"\n",
        "                f\"in the baseline (delta {fm - bm:+.1f} st = {z:.1f} sigma, sigma={C.TOL_PITCH_ST} st). {tip}\")\n",
        "    if t in (\"TOO_FAST\", \"TOO_SLOW\"):\n",
        "        tip = (\"Compressed syllables reduce clarity and leave no room to breathe; slow down on key phrases.\"\n",
        "               if t == \"TOO_FAST\" else \"Dragging the pace loses momentum and energy; tighten the delivery.\")\n",
        "        return (f\"Syllable-nuclei rate is {fm:.1f}/s vs {bm:.1f}/s on the same words ({(fm / bm - 1) * 100:+.0f}%, \"\n",
        "                f\"{z:.1f} sigma, sigma={C.TOL_RATE * 100:.0f}%). Rate is measured over speech time only, so pauses do not \"\n",
        "                f\"distort it. {tip}\")\n",
        "    if t == \"LONG_PAUSE\":\n",
        "        return (f\"Silence of {fm:.2f}s exceeds the allowed {r['thr']:.2f}s, which is max({C.PAUSE_MIN_FLAW_SEC}s, \"\n",
        "                f\"{C.PAUSE_FACTOR}x the baseline's 95th-percentile pause of {bm:.2f}s). Long unplanned silence breaks the \"\n",
        "                f\"flow of the argument; use short, deliberate pauses at phrase boundaries instead.\")\n",
        "    return \"\"\n",
        "\n",
        "\n",
        "def _region(typ, start, end, z, base, flaw, **extra):\n",
        "    r = {\"type\": typ, \"start\": round(float(start), 2), \"end\": round(float(end), 2),\n",
        "         \"severity_z\": round(float(z), 2), \"base\": float(base), \"flaw\": float(flaw), \"z\": float(z)}\n",
        "    r.update(extra)\n",
        "    r[\"explanation\"] = explain(r)\n",
        "    return r\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------- main entry\n",
        "def run(fb, ff, lo=None, hi=None):\n",
        "    if lo is None:\n",
        "        lo, hi = dtw_map(fb, ff)\n",
        "    W = int(round(C.WIN_SEC / C.HOP_SEC))\n",
        "    S = int(round(C.WIN_HOP_SEC / C.HOP_SEC))\n",
        "\n",
        "    wins = []\n",
        "    for a in range(0, max(1, ff[\"n\"] - W + 1), S):\n",
        "        b = min(a + W, ff[\"n\"])\n",
        "        ba, bb = int(lo[a]), int(hi[b - 1])\n",
        "        if bb - ba < 5:\n",
        "            continue\n",
        "        mf, mb = window_metrics(ff, a, b), window_metrics(fb, ba, bb)\n",
        "        z = {}\n",
        "        if _ok(mf[\"energy\"], mb[\"energy\"]):\n",
        "            z[\"energy\"] = (mf[\"energy\"] - mb[\"energy\"]) / C.TOL_ENERGY_DB\n",
        "        if _ok(mf[\"pitch\"], mb[\"pitch\"]):\n",
        "            z[\"pitch\"] = (mf[\"pitch\"] - mb[\"pitch\"]) / C.TOL_PITCH_ST\n",
        "        if _ok(mf[\"rate\"], mb[\"rate\"]) and mb[\"rate\"] > 0:\n",
        "            z[\"rate\"] = (mf[\"rate\"] / mb[\"rate\"] - 1) / C.TOL_RATE\n",
        "        wins.append({\"t0\": a * C.HOP_SEC, \"t1\": b * C.HOP_SEC, \"z\": z, \"f\": mf, \"b\": mb})\n",
        "\n",
        "    regions = []\n",
        "    for key, (pos, neg) in RULES.items():\n",
        "        for typ, cond in ((pos, lambda v: v > C.Z_FLAG), (neg, lambda v: v < -C.Z_FLAG)):\n",
        "            flagged = [w for w in wins if key in w[\"z\"] and cond(w[\"z\"][key])]\n",
        "            for g in _merge(flagged):\n",
        "                if len(g) < C.MIN_REGION_WINDOWS:\n",
        "                    continue\n",
        "                centers = [(w[\"t0\"] + w[\"t1\"]) / 2 for w in g]\n",
        "                start, end = max(0.0, min(centers) - 0.25), max(centers) + 0.25\n",
        "                z_mean = float(np.mean([abs(w[\"z\"][key]) for w in g]))\n",
        "                regions.append(_region(typ, start, min(end, ff[\"duration\"]), z_mean,\n",
        "                                       np.mean([w[\"b\"][key] for w in g]),\n",
        "                                       np.mean([w[\"f\"][key] for w in g]),\n",
        "                                       feature=key, n_windows=len(g)))\n",
        "\n",
        "    # pauses: compare against what the baseline speaker does naturally\n",
        "    bp = [e - s for s, e in fb[\"pauses\"]]\n",
        "    ref = float(np.percentile(bp, 95)) if bp else 0.0\n",
        "    thr = max(C.PAUSE_MIN_FLAW_SEC, C.PAUSE_FACTOR * ref)\n",
        "    for s, e in ff[\"pauses\"]:\n",
        "        if e - s > thr:\n",
        "            regions.append(_region(\"LONG_PAUSE\", s, e, 2 * (e - s) / thr, ref, e - s,\n",
        "                                   feature=\"pause\", thr=thr))\n",
        "    regions.sort(key=lambda r: r[\"start\"])\n",
        "\n",
        "    # rubric scores (0-100). Per window severity = clip((|z|-1)/5, 0, 1)\n",
        "    def dim(key):\n",
        "        s = [min(1.0, max(0.0, (abs(w[\"z\"][key]) - 1) / 5)) for w in wins if key in w[\"z\"]]\n",
        "        return 100 * (1 - float(np.mean(s))) if s else 100.0\n",
        "\n",
        "    pause_sev = sum(min(1.0, max(0.0, (r[\"z\"] - 1) / 5)) for r in regions if r[\"type\"] == \"LONG_PAUSE\")\n",
        "    scores = {\"volume\": dim(\"energy\"), \"pacing\": dim(\"rate\"), \"pitch\": dim(\"pitch\"),\n",
        "              \"pauses\": 100 * (1 - min(1.0, pause_sev))}\n",
        "    scores[\"overall\"] = sum(C.WEIGHTS[k] * scores[k] for k in C.WEIGHTS)\n",
        "    scores = {k: round(v, 1) for k, v in scores.items()}\n",
        "\n",
        "    # curves for the dashboard overlay (50 ms resolution, baseline warped onto participant time)\n",
        "    step = 5\n",
        "    idx = np.arange(0, ff[\"n\"], step)\n",
        "    with warnings.catch_warnings():\n",
        "        warnings.simplefilter(\"ignore\", RuntimeWarning)\n",
        "        curves = {\n",
        "            \"t\": _clean(idx * C.HOP_SEC),\n",
        "            \"energy_flaw\": _clean(ff[\"rms_db\"][idx]),\n",
        "            \"energy_base\": _clean([fb[\"rms_db\"][lo[j]:hi[j]].mean() for j in idx]),\n",
        "            \"pitch_flaw\": _clean([_nanmean(ff[\"f0_st\"][j:j + step]) for j in idx]),\n",
        "            \"pitch_base\": _clean([_nanmean(fb[\"f0_st\"][lo[j]:hi[j]]) for j in idx]),\n",
        "            \"windows\": [{\"t\": round((w[\"t0\"] + w[\"t1\"]) / 2, 3),\n",
        "                         **{k: (round(w[\"z\"][k], 3) if k in w[\"z\"] else None) for k in RULES}} for w in wins],\n",
        "        }\n",
        "\n",
        "    def art_rate(f):\n",
        "        act_t = f[\"active\"].sum() * C.HOP_SEC\n",
        "        return len(f[\"peaks\"]) / act_t if act_t > 0 else float(\"nan\")\n",
        "\n",
        "    glob = {\n",
        "        \"duration_base\": round(fb[\"duration\"], 2), \"duration_flaw\": round(ff[\"duration\"], 2),\n",
        "        \"syllable_rate_base\": round(art_rate(fb), 2), \"syllable_rate_flaw\": round(art_rate(ff), 2),\n",
        "        \"n_pauses_base\": len(fb[\"pauses\"]), \"n_pauses_flaw\": len(ff[\"pauses\"]),\n",
        "        \"pause_threshold_sec\": round(thr, 2),\n",
        "        \"median_f0_hz_base\": round(fb[\"median_f0_hz\"], 1), \"median_f0_hz_flaw\": round(ff[\"median_f0_hz\"], 1),\n",
        "        \"mean_energy_db_base\": round(float(fb[\"rms_db\"][fb[\"active\"]].mean()), 2),\n",
        "        \"mean_energy_db_flaw\": round(float(ff[\"rms_db\"][ff[\"active\"]].mean()), 2),\n",
        "        \"spectral_flatness_base\": round(float(fb[\"flatness\"][fb[\"active\"]].mean()), 4),\n",
        "        \"spectral_flatness_flaw\": round(float(ff[\"flatness\"][ff[\"active\"]].mean()), 4),\n",
        "    }\n",
        "    return {\"regions\": regions, \"scores\": scores, \"curves\": curves, \"global\": glob}\n"
      ]
    },
